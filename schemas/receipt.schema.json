{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/devdesiignn/vela-core/schemas/receipt.schema.json",
  "title": "Receipt",
  "type": "object",
  "required": [
    "id",
    "store_id",
    "source_image_id",
    "transaction_ref",
    "date",
    "total",
    "content_hash"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "store_id": { "type": "string", "format": "uuid" },
    "source_image_id": { "type": "string" },
    "transaction_ref": { "type": "string" },
    "transaction_ref_label": { "type": ["string", "null"] },
    "register_ref": { "type": ["string", "null"] },
    "date": { "type": "string", "format": "date" },
    "time": { "type": ["string", "null"], "format": "time" },
    "staff_name": { "type": ["string", "null"] },
    "customer_name": { "type": ["string", "null"] },
    "payment_method": { "type": ["string", "null"] },
    "subtotal": { "type": ["number", "null"] },
    "discount": { "type": ["number", "null"] },
    "vat": { "type": ["number", "null"] },
    "consumption_tax": { "type": ["number", "null"] },
    "total": { "type": "number" },
    "total_in_words": { "type": ["string", "null"] },
    "content_hash": {
      "type": "string",
      "description": "Fingerprint of key receipt fields, unique per receipt. Guards against the same physical receipt being ingested twice (e.g. re-photographed)."
    },
    "extras": {
      "type": ["object", "null"],
      "description": "Store-specific or one-off fields not promoted to a dedicated column: barcode/QR presence, website, items-count line, promotional or return-policy footer text, secondary reference numbers, etc.",
      "additionalProperties": true
    },
    "line_items": {
      "type": "array",
      "items": { "$ref": "line_item.schema.json" }
    }
  }
}
